# Copy this to .env and fill in your actual values.
# .env should be in .gitignore — NEVER commit real credentials.

# === Flask ===
# Generate a random secret key for production: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=dev-secret-change-me

# === Email (SendGrid) ===
# Create a SendGrid account and generate an API key at
# https://app.sendgrid.com/settings/api_keys
# The key needs "Mail Send" permission.
SENDGRID_API_KEY=SG.your-api-key-here

# The FROM name and address that students will see. The sending domain
# must be verified in SendGrid (Settings > Sender Authentication).
SENDER_NAME=ThinkNeuro
SENDER_EMAIL=certificates@thinkneuro.org

# Set to "true" to actually send emails. When "false", PDFs are generated
# but emails are only PRINTED, not sent.
SEND_EMAILS=false

# Where batch results reports (checkpoint + final CSV of who was sent what)
# are emailed. Defaults to SENDER_EMAIL when unset. These reports are the
# durable send record — there is no database.
# RESULTS_EMAIL=ops@thinkneuro.org

# === Durable presets (optional) ===
# When set, presets created/edited in the web UI are committed straight to
# presets.json in the GitHub repo, so they survive redeploys with no manual
# export step. Create a fine-grained personal access token at
# https://github.com/settings/personal-access-tokens with access to ONLY
# this repository and the "Contents: Read and write" permission.
# Commits are tagged [skip render] so they don't trigger a redeploy.
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_REPO=dominicgodfrey/certificate-automation
# GITHUB_BRANCH=main

# === Admin login ===
# The single operator account. There is no user database — these ARE the
# live credentials; login is disabled until DEFAULT_ADMIN_PASSWORD is set.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=changeme
